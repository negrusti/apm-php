# Keep the actual file at /etc/relay-apm/relay.env, readable only by root and relay-apm.
APM_LISTEN=127.0.0.1:8088
APM_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
APM_CLIENTS_FILE=/etc/relay-apm/clients.json
APM_COLLECTOR_HOST=apm.example.com
APM_SECURE_COOKIES=true
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=relay_apm
CLICKHOUSE_USER=relay
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_USER_PASSWORD
